{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/admin/login", "destination": "/api/handler?route=admin/login" },
    { "source": "/api/admin/order-action", "destination": "/api/handler?route=admin/order-action" },
    { "source": "/api/admin/orders", "destination": "/api/handler?route=admin/orders" },
    { "source": "/api/admin/mp/connect", "destination": "/api/handler?route=admin/mp/connect" },
    { "source": "/api/admin/mp/status", "destination": "/api/handler?route=admin/mp/status" },
    { "source": "/api/admin/mp/payments", "destination": "/api/handler?route=admin/mp/payments" },
    { "source": "/api/payments/options", "destination": "/api/handler?route=payments/options" },
    { "source": "/api/push/key", "destination": "/api/handler?route=push/key" },
    { "source": "/api/push/subscribe", "destination": "/api/handler?route=push/subscribe" },
    { "source": "/api/push/unsubscribe", "destination": "/api/handler?route=push/unsubscribe" },
    { "source": "/api/push/order-status", "destination": "/api/handler?route=push/order-status" },
    { "source": "/api/auth/signup", "destination": "/api/handler?route=auth/signup" },
    { "source": "/api/catalog/facets", "destination": "/api/handler?route=catalog/facets" },
    { "source": "/api/catalog/products", "destination": "/api/handler?route=catalog/products" },
    { "source": "/api/mp/oauth/callback", "destination": "/api/handler?route=mp/oauth/callback" },
    { "source": "/api/orders/create", "destination": "/api/handler?route=orders/create" },
    { "source": "/api/orders/mine", "destination": "/api/handler?route=orders/mine" },
    { "source": "/api/orders/reconcile", "destination": "/api/handler?route=orders/reconcile" },
    { "source": "/api/orders/status", "destination": "/api/handler?route=orders/status" },
    { "source": "/api/orders/webhook", "destination": "/api/handler?route=orders/webhook" }
  ]
}
