# Backend only. Never prefix the secret key with VITE_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Public values used by Supabase Auth in the browser.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_replace_me

# Marketplace OAuth: app credentials belong to the integrator and stay server-side.
# The seller connects from the local's protected Orders panel; never paste seller tokens here.
MERCADOPAGO_ENV=test
MERCADOPAGO_CLIENT_ID=replace_with_marketplace_app_client_id
MERCADOPAGO_CLIENT_SECRET=replace_with_marketplace_app_client_secret
MERCADOPAGO_REDIRECT_URI=https://your-test-site.example/api/mp/oauth/callback
MP_TOKEN_ENCRYPTION_KEY=replace_with_base64_encoded_32_byte_key
MERCADOPAGO_TEST_USER_ID=replace_with_the_test_seller_user_id
MERCADOPAGO_WEBHOOK_SECRET=replace_me_with_webhook_signing_secret
PUBLIC_APP_URL=https://your-test-site.example

# Temporary read-only staff panel. Use a long, unique password; never prefix with VITE_.
SHOP_ADMIN_PASSWORD=replace_me_with_a_long_unique_password

PORT=4173

# Payments. The online payment (Mercado Pago) surcharge, in percent (default 8).
ONLINE_SURCHARGE_PERCENT=8
# Account that receives bank transfers. Transfer is offered only when alias, a 22-digit CVU and holder are set.
TRANSFER_ALIAS=
TRANSFER_CVU=
TRANSFER_HOLDER=
TRANSFER_BANK=Mercado Pago
# Shared key so gestión can read the latest Mercado Pago collections (at least 24 characters).
# Put the same value in gestión as SHOP_STAFF_API_KEY.
STAFF_API_KEY=

# Web push notifications to buyers when an order changes status. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://perfumeria-cr.vercel.app
