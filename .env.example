# Backend only. Never prefix the secret key with VITE_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Public values used by Supabase Auth in the browser.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_replace_me

# Temporary payments are hard-disabled unless you explicitly select test credentials.
# Use the test Access Token from the Mercado Pago application (Checkout Pro Orders).
MERCADOPAGO_ENV=test
MERCADOPAGO_ACCESS_TOKEN=APP_USR_test_replace_me
MERCADOPAGO_TEST_USER_ID=replace_with_the_test_seller_account_id
MERCADOPAGO_WEBHOOK_SECRET=replace_me_with_webhook_signing_secret
PUBLIC_APP_URL=https://your-test-site.example

# Temporary read-only staff panel. Use a long, unique password; never prefix with VITE_.
SHOP_ADMIN_PASSWORD=replace_me_with_a_long_unique_password

PORT=4173
